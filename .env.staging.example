DATABASE_URL=sqlite:////app/var/fraggy.db
CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120
API_CACHE_TTL_SECONDS=5
SCRAPER_USER_AGENT=FraggyAPI/0.1
SCRAPE_DELAY_SECONDS=20
SYNC_LOCK_PATH=/app/var/sync.lock
# Keep unattended scraping disabled.
SCRAPING_APPROVED_SOURCES=
LIVE_VALIDATED_SOURCES=
# Optional API gateway credential, supplied securely only if needed:
FRAGGY_API_TOKEN=
