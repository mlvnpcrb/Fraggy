# SQLite for local development. In production use postgresql+psycopg://...
DATABASE_URL=sqlite:///var/fraggy.db
SCRAPE_DELAY_SECONDS=20
SCRAPER_USER_AGENT=FraggyAPI/0.1
CORS_ORIGINS=
SYNC_LOCK_PATH=var/sync.lock
SYNC_SOURCES=all

# Leave empty until source permissions and live extraction are confirmed.
SCRAPING_APPROVED_SOURCES=
LIVE_VALIDATED_SOURCES=
API_RATE_LIMIT_PER_MINUTE=120
API_CACHE_TTL_SECONDS=5
