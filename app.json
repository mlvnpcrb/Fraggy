{
  "expo": {
    "name": "Fraggy",
    "slug": "fraggy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fraggy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fraggy.prototype"
    },
    "android": {
      "package": "app.fraggy.prototype"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fraggy to add bottle photos to your personal shelf.",
          "cameraPermission": "Allow Fraggy to photograph a bottle for your shelf.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "name": "Fraggy",
      "bundler": "metro"
    },
    "icon": "./assets/fraggy-icon.png",
    "owner": "mlvnpcrb",
    "extra": {
      "eas": {
        "projectId": "8cb3bdfe-b4d0-46d1-886a-af42e506050f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8cb3bdfe-b4d0-46d1-886a-af42e506050f"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
