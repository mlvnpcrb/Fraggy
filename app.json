{
  "expo": {
    "name": "Fraggy",
    "slug": "fraggy",
    "scheme": "fraggy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-font"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fraggy.app"
    },
    "android": {
      "package": "com.fraggy.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Fraggy"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
